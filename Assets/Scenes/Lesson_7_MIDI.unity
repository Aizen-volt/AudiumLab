    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "MIDI (Musical Instrument Digital Interface) to system s\u0142u\u017C\u0105cy
        do przekazywania informacji mi\u0119dzy elektronicznymi instrumentami muzycznymi.\n\nW
        szczeg\xF3lno\u015Bci:\n- nie jest formatem audio tylko protoko\u0142em komunikacji,\n-
        nie zawiera fali d\u017Awi\u0119kowej,\n- zawiera zdarzenia steruj\u0105ce:\n<margin=3em>a)kiedy
        zagra\u0107,\nb) jak\u0105 wysoko\u015B\u0107,\nc) jak g\u0142o\u015Bno,\nd)
        jakim instrumentem.</margin>"
      objectReference: {fileID: 0}
