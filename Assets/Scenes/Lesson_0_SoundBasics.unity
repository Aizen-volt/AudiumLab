    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Fala d\u017Awi\u0119kowa to <b>zmiana ci\u015Bnienia w czasie</b>,
        kt\xF3r\u0105 mo\u017Cna zapisa\u0107 jako wykres.\n\nNajprostsza fala to
        <b>sinusoida</b>. Odpowiada czystemu tonowi np. d\u017Awi\u0119kowi kamertonu.\n\nKa\u017Cdy
        d\u017Awi\u0119k ma trzy g\u0142\xF3wne parametry:\n\t- <b>Amplituda</b>
        - okre\u015Bla g\u0142o\u015Bno\u015B\u0107,\n\t- <b>Cz\u0119stotliwo\u015B\u0107</b>
        - okre\u015Bla wysoko\u015B\u0107 d\u017Awi\u0119ku,\n\t- <b>Faza</b> - okre\u015Bla
        przesuni\u0119cie w czasie."
      objectReference: {fileID: 0}
