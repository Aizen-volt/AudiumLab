    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Poni\u017Csze przyciski pozwalaj\u0105 na odtworzenie fragmentu piosenki
        Funkytown zespo\u0142u Lipps Inc. Ka\u017Cdy kolejny przycisk odtwarza pliki
        o coraz mniejszej cz\u0119stotliwo\u015Bci pr\xF3bkowania. \n\n\n\t\t\t44,1kHz 
        - jako\u015B\u0107 CD-Audio\n\n\n\t\t\t22,05kHz\n\n\n\t\t\t8kHz \n\nOds\u0142uchaj
        i por\xF3wnaj jak cz\u0119stotliwo\u015B\u0107 pr\xF3bkowania wp\u0142ywa
        \nna jako\u015B\u0107 d\u017Awi\u0119ku."
      objectReference: {fileID: 0}
