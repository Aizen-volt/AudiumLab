    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Iluzja akustyczna to sytuacja, w kt\xF3rej:\n- sygna\u0142 fizyczny
        jest jednoznaczny,\n- percepcja s\u0142uchowa zale\u017Cy od kontekstu, oczekiwa\u0144
        lub konstrukcji bod\u017Aca.\n\n<u>Ucho rejestruje fale d\u017Awi\u0119kowe,
        ale to m\xF3zg interpretuje d\u017Awi\u0119k.</u>\n\nIluzje akustyczne powstaj\u0105
        przez:\n- ograniczon\u0105 rozdzielczo\u015B\u0107 czasow\u0105 i cz\u0119stotliwo\u015Bciow\u0105
        s\u0142uchu,\n- maskowanie cz\u0119stotliwo\u015Bci,\n- mechanizmy predykcyjne
        m\xF3zgu,\n- integracj\u0119 d\u017Awi\u0119ku z innymi zmys\u0142ami (np.
        wzrokiem)."
      objectReference: {fileID: 0}
