    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Reverb imituje odbicia d\u017Awi\u0119ku od \u015Bcian. Od efektu delay
        r\xF3\u017Cni si\u0119 tym, \u017Ce:\n- delay - sk\u0142ada si\u0119 z pojedynczych
        powt\xF3rek pr\xF3bki,\n- reverb - sk\u0142ada si\u0119 z wielu bardzo kr\xF3tkich
        \"odbi\u0107\" d\u017Awi\u0119ku.\n\nDzi\u0119ki temu d\u017Awi\u0119k wydaje
        si\u0119 dalszy, wi\u0119kszy, \"w pomieszczeniu\". Reverb korzysta z faktu,
        \u017Ce ucho rozpoznaje przestrze\u0144 po:\n- czasie zaniku d\u017Awi\u0119ku,\n-
        g\u0119sto\u015Bci odbi\u0107."
      objectReference: {fileID: 0}
