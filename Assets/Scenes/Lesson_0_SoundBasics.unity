    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Faza okre\u015Bla, w kt\xF3rym momencie cyklu zaczyna si\u0119 fala.\n\nDwie
        fale o tej samej cz\u0119stotliwo\u015Bci, ale przesuni\u0119te w fazie,
        mog\u0105 si\u0119 sumowa\u0107 lub znosi\u0107.\n\nTo zjawisko nazywamy
        interferencj\u0105.\n\nW\u0142\u0105cz odtwarzanie dw\xF3ch ton\xF3w sinusoidalnych
        przesuni\u0119tych wzgl\u0119dem siebie za pomoc\u0105 przycisku \"Odtw\xF3rz\"
        poni\u017Cej. Zmieniaj faz\u0119 za pomoc\u0105 suwaka. Zaobserwuj zmian\u0119
        g\u0142o\u015Bno\u015Bci dla \u03C6 < 180\xB0, \u03C6 = 180\xB0, \u03C6 >
        180\xB0. Zako\u0144cz odtwarzanie przyciskiem \"Zatrzymaj\"."
      objectReference: {fileID: 0}
    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_HorizontalAlignment
      value: 1
      objectReference: {fileID: 0}
