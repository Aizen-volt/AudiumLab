    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Poni\u017Cej znajduje si\u0119 fragment piosenki Funkytown zespo\u0142u
        Lipps Inc. zapisany w r\xF3\u017Cnych <b>rozdzielczo\u015Bciach bitowych</b>. 
        Przes\u0142uchaj je \ni por\xF3wnaj jako\u015B\u0107 ods\u0142uchu. \n\n\n\t\t\t24-bit
        czyli 16\_777\_216 warto\u015Bci amplitudy\n\n\n\t\t\t16-bit czyli 65\_536
        warto\u015Bci amplitudy\n\n\n\t\t\t8-bit czyli 256 warto\u015Bci amplitudy\n\nCzy
        w kt\xF3rym\u015B z plik\xF3w by\u0142 s\u0142yszalny szum kwantyzacji? Czym
        by\u0142 spowodowany?\n"
      objectReference: {fileID: 0}
