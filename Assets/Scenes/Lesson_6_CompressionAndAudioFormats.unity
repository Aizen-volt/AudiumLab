    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Schemat (wysoki poziom):\n\n1. PCM \u2192 podzia\u0142 na ramki,\n\n2.
        transformacja do domeny cz\u0119stotliwo\u015Bci (MDCT),\n\n3. model psychoakustyczny,\n\n4.
        odrzucenie / kwantyzacja mniej istotnych sk\u0142adowych,\n\n5. kodowanie
        entropijne.\n\nMP3 i AAC nie usuwaj\u0105 \"losowo\" danych. Usuwaj\u0105
        dane statystycznie i percepcyjnie nieistotne.\n"
      objectReference: {fileID: 0}
