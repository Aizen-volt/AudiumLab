    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Efekt d\u017Awi\u0119kowy to zmiana ju\u017C istniej\u0105cego d\u017Awi\u0119ku.\n\nNie
        tworzy nowego d\u017Awi\u0119ku, tylko:\n- zmienia, kt\xF3re cz\u0119stotliwo\u015Bci
        sk\u0142adowe s\u0105 s\u0142yszalne,\n- zmienia, jak d\u0142ugo d\u017Awi\u0119k
        trwa,\n- zmienia, jak d\u017Awi\u0119k jest postrzegany przez ucho.\n\nEfekty
        d\u017Awi\u0119kowe bazuj\u0105 na modyfikacji:\n- widma d\u017Awi\u0119ku,\n-
        czasu,\n- alikwot\xF3w,\n- percepcji s\u0142uchu.\n\nW og\xF3lno\u015Bci
        efekt d\u017Awi\u0119kowy mo\u017Cna traktowa\u0107 jak algorytm filtruj\u0105cy
        sygna\u0142 audio w dziedzinie cz\u0119stotliwo\u015Bci i/lub czasu."
      objectReference: {fileID: 0}
    - target: {fileID: 6587118492794903600, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_OnClick.m_PersistentCalls.m_Calls.Array.data[0].m_Target
