    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Ka\u017Cdy d\u017Awi\u0119k okresowy mo\u017Cna opisa\u0107 przebiegiem
        w czasie. To, jak wygl\u0105da jego kszta\u0142t, wp\u0142ywa na barw\u0119,
        nawet je\u015Bli wysoko\u015B\u0107 d\u017Awi\u0119ku jest taka sama.\n\nSinusoida
        - brzmi \u201Eczysto\u201D, jak idealny ton laboratoryjny.\n\nFala prostok\u0105tna
        - brzmi jasno, \u201Episzcz\u0105co\u201D, przypomina d\u017Awi\u0119k starych
        gier wideo.\n\nFala pi\u0142okszta\u0142tna - brzmi bardzo bogato i ostro.
        Cz\u0119sto u\u017Cywana w syntezatorach analogowych.\n\nFala tr\xF3jk\u0105tna
        - brzmi \u0142agodniej ni\u017C prostok\u0105t, ale pe\u0142niej ni\u017C
        sinusoida."
      objectReference: {fileID: 0}
    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_HorizontalAlignment
      value: 1
      objectReference: {fileID: 0}
