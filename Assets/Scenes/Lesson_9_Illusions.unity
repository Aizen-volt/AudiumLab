    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Gdy d\u017Awi\u0119k zostaje chwilowo przerwany przez g\u0142o\u015Bny
        szum, m\xF3zg uzupe\u0142nia brakuj\u0105cy fragment i s\u0142yszy go jako
        ci\u0105g\u0142y.\n\nTo ta sama strategia, kt\xF3r\u0105 wykorzystujemy,
        s\u0142uchaj\u0105c mowy w ha\u0142asie:\n- szum maskuje fragment sygna\u0142u,\n-
        m\xF3zg zak\u0142ada, \u017Ce d\u017Awi\u0119k nie znikn\u0105\u0142, tylko
        zosta\u0142 zag\u0142uszony."
      objectReference: {fileID: 0}
