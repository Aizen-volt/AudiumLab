    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Equalizer to bank filtr\xF3w:\n- dolnoprzepustowych,\n- g\xF3rnoprzepustowych,\n-
        pasmowych.\n\nKa\u017Cdy suwak equalizera wzmacnia lub t\u0142umi konkretny
        zakres cz\u0119stotliwo\u015Bci. Nie zmienia czasu trwania sygna\u0142u,
        tylko jego widmo - barw\u0119.\n\nAplikacje do odtwarzania muzyki (Spotify,
        Apple Music) s\u0105 wyposa\u017Cone w gotowe equalizery, przygotowane z
        my\u015Bl\u0105 o konkretnych zastosowaniach:\n- Pop\n- Jazz\n- Klasyczna\n-
        G\u0142\u0119bia\n- Ma\u0142e g\u0142o\u015Bniki"
      objectReference: {fileID: 0}
