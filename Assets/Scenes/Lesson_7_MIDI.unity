    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Bank brzmie\u0144 - zestaw regu\u0142 m\xF3wi\u0105cych syntezatorowi
        MIDI:\n\n- jak\u0105 pr\xF3bk\u0119 odtworzy\u0107,\n\n- dla jakiej nuty
        MIDI,\n\n- z jak\u0105 g\u0142o\u015Bno\u015Bci\u0105, obwiedni\u0105 i artykulacj\u0105.\n\nJednym
        z najwa\u017Cniejszych standard\xF3w bank\xF3w brzmie\u0144 jest <b>SoundFont</b>.
        Wsp\xF3\u0142cze\u015Bnie termin <i>soundfont</i> bywa u\u017Cywany szerzej
        - analogicznie do tego, jak s\u0142owo \"Coke\" bywa u\u017Cywane na dowolny
        nap\xF3j typu cola.\n\nW skr\xF3cie:\n- MIDI opisuje, co zagra\u0107,\n-
        bank brzmie\u0144 opisuje, jak to zabrzmi."
      objectReference: {fileID: 0}
    - target: {fileID: 6587118492794903600, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
