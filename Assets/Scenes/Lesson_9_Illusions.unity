    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "Paradoks trytonu to zjawisko polegaj\u0105ce na tym, \u017Ce ten sam
        interwa\u0142 (tryton, 6 p\xF3\u0142ton\xF3w) odtworzony w formie tonu Sheparda
        bywa s\u0142yszany przez r\xF3\u017Cne osoby jako wznosz\u0105cy si\u0119
        albo opadaj\u0105cy. \n\nBadania pokazuj\u0105 korelacj\u0119 tej percepcji
        z:\n- j\u0119zykiem ojczystym,\n- \u015Brodowiskiem kulturowym,\n- ekspozycj\u0105
        muzyczn\u0105."
      objectReference: {fileID: 0}
