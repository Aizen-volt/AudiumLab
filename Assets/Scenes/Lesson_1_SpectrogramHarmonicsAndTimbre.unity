    - target: {fileID: 6007252561513758722, guid: 15856d17d8972054a8a07e82dfa90f01, type: 3}
      propertyPath: m_text
      value: "\n<b>Czysta sinusoida </b>- jedna cienka, pozioma linia.\n\n<b>D\u017Awi\u0119k
        harmoniczny</b> (instrument, mowa) - wiele r\xF3wnoleg\u0142ych linii.\n\n<b>Szum</b>
        - r\xF3wnomierne \u201Ewype\u0142nienie\u201D ca\u0142ego zakresu cz\u0119stotliwo\u015Bci.\n"
      objectReference: {fileID: 0}
